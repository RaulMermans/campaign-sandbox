# Default: mock. Use openai only when a server-side API key is configured.
# The app builds and runs fully without any env vars set.
CAMPAIGN_SANDBOX_LLM_PROVIDER=mock

# Required only when CAMPAIGN_SANDBOX_LLM_PROVIDER=openai.
# Never expose this to the browser. Never use NEXT_PUBLIC_ for this variable.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini
