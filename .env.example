# Default: mock. Use openai only when a server-side API key is configured.
# The app builds and runs fully without any env vars set.
CAMPAIGN_SANDBOX_LLM_PROVIDER=mock

# Required only when CAMPAIGN_SANDBOX_LLM_PROVIDER=openai.
# Never expose this to the browser. Never use NEXT_PUBLIC_ for this variable.
OPENAI_API_KEY=your_server_side_openai_key_here

# Optional model override. Defaults to gpt-4.1-mini.
OPENAI_MODEL=gpt-4.1-mini

# Internal access password for the deployed app. Required in deployed
# environments — every page and /api/campaign/* route is gated behind it.
# Never commit a real value here.
INTERNAL_APP_PASSWORD=replace_me

# Set to "true" only for local development to bypass the access gate.
# Must remain "false" (or unset) in any deployed environment.
DISABLE_INTERNAL_PASSWORD=false
