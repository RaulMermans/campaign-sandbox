{
  "name": "campaign-sandbox",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:core": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:full": "pnpm verify && pnpm build",
    "test:real-chain": "node scripts/test-real-chain.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "next": "16.2.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.17.0",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5.9.2",
    "vitest": "0.34.6"
  }
}
